<div class="box" style="margin-top: 20px;">
  <h3>Импорт спецификации из DOCX</h3>
  <p>Загрузите Word-документ с ГОСТ-заголовками (стили «Заголовок 1/2/3»).</p>
  
  <% form_url = url_for(controller: 'docx_import', action: 'upload', project_id: @project) %>
  <%= form_tag(form_url, method: :post, multipart: true) do %>
    <p>
      <label for="file">Файл .docx:</label>
      <%= file_field_tag 'file', accept: '.docx' %>
    </p>
    <p>
      <strong>Режим импорта:</strong>
    </p>
    <p>
      <label>
        <%= radio_button_tag 'import_mode', 'cards', true %>
        Создавать карточки для всех конечных разделов
      </label>
    </p>
    <p>
      <label>
        <%= radio_button_tag 'import_mode', 'checklist' %>
        Разделы 1-2 уровня как задачи, подразделы 3-го как чек-лист
      </label>
    </p>
    <p>
      <%= submit_tag 'Загрузить и создать задачи', class: 'button-positive' %>
    </p>
  <% end %>
</div>